# --- Database ---------------------------------------------------------
# Shared Postgres instance (with pgvector extension). This service only
# ever touches the person_* tables, but the DSN itself is shared with
# other teams' services.
DATABASE_URL=postgresql://netra_user:netra_password@localhost:5432/netra_cctv

# --- Core service -------------------------------------------------------
# Where matched alerts get POSTed so they can be pushed live to the frontend.
CORE_ALERT_URL=http://localhost:8000/alerts/person

# --- Matching / alerting tuning ------------------------------------------
# Cosine distance threshold for a watchlist match (lower = stricter).
MATCH_THRESHOLD=0.4

# Minimum seconds between repeat alerts for the same (camera_id, person_id).
ALERT_COOLDOWN_SECONDS=60

# --- Storage --------------------------------------------------------------
# Where cropped face JPEGs get saved (never full frames).
CROP_STORAGE_DIR=./crops